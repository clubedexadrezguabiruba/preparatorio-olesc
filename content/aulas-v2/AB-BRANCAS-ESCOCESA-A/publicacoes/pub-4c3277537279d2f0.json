          },
          "no-cap-00-6": {
            "id": "no-cap-00-6",
            "uci": "e5d4",
            "filhos": [
              "no-cap-00-7"
            ],
            "comentario": "O peão de e5 estava atacado duas vezes e defendido uma só. As Pretas trocam: é o caminho mais comum."
