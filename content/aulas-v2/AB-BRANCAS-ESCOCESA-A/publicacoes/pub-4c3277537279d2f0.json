            "filhos": [
              "no-cap-00-2"
            ],
            "comentario": "Abrimos com o peão do rei. Ele ocupa o centro e solta o bispo e a dama."
          },
          "no-cap-00-2": {
            "id": "no-cap-00-2",
            "uci": "e7e5",
            "filhos": [
              "no-cap-00-3"
            ],
            "comentario": "As Pretas respondem do mesmo jeito. O peão delas também vai ao centro e trava o nosso."
