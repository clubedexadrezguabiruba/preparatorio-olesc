        "orientacao": "white",
        "narracoes": [
          {
            "id": "narracao-no-cap-d17-0",
            "nodeId": "no-cap-d17-0",
            "texto": "Maxime Vachier-Lagrave venceu Wesley So em Stavanger, no Norway Blitz de 2017.",
            "pausa": "temporizada",
            "rotulo": "Partida real"
          },
          {
            "id": "narracao-no-cap-d17-0-2",
            "nodeId": "no-cap-d17-0",
            "texto": "Observe principalmente o desenvolvimento inicial e a atividade das peças. A partida inteira é modelo de ideias, não uma linha para decorar lance por lance.",
            "pausa": "temporizada",
            "rotulo": "Como usar"
          },
          {
            "id": "narracao-no-cap-d17-5",
            "nodeId": "no-cap-d17-5",
            "texto": "Nossa arma aparece exatamente como no repertório.",
            "pausa": "temporizada"
          },
          {
            "id": "narracao-no-cap-d17-13",
            "nodeId": "no-cap-d17-13",
            "texto": "Aqui está a posição-base ensinada no curso: bispo em f3, cavalo em e2 e bispo em e3.",
            "pausa": "temporizada",
            "rotulo": "Esquema"
          },
          {
            "id": "narracao-no-cap-d17-16",
            "nodeId": "no-cap-d17-16",
            "texto": "Esta é a defesa crítica estudada no capítulo C12.",
            "pausa": "temporizada",
            "rotulo": "Conexão"
          },
          {
            "id": "narracao-no-cap-d17-17",
            "nodeId": "no-cap-d17-17",
            "texto": "Nesta partida, MVL escolheu 9.O-O. Nosso repertório oficial ensina 9.Nc3 contra ...Ne5. Portanto, não troque a linha do Move Trainer por esta escolha da partida modelo. Daqui em diante, estudamos planos e atividade, não memorização.",
            "pausa": "temporizada",
            "rotulo": "Atenção"
          },
          {
            "id": "narracao-no-cap-d17-23",
            "nodeId": "no-cap-d17-23",
            "texto": "A torre ocupa imediatamente a coluna d aberta e ganha atividade.",
            "pausa": "temporizada"
          },
          {
            "id": "narracao-no-cap-d17-33",
            "nodeId": "no-cap-d17-33",
            "texto": "A dama entra numa casa ativa e aumenta a pressão sobre as casas centrais.",
            "pausa": "temporizada"
          },
          {
            "id": "narracao-no-cap-d17-41",
            "nodeId": "no-cap-d17-41",
            "texto": "Uma ideia temática de partida modelo: quando a coluna está aberta, a torre pode invadir a sexta fila.",
            "pausa": "temporizada"
          },
          {
            "id": "narracao-no-cap-d17-59",
            "nodeId": "no-cap-d17-59",
            "texto": "As Brancas ganham espaço e mantêm o rei preto desconfortável.",
            "pausa": "temporizada"
          },
          {
            "id": "narracao-no-cap-d17-79",
            "nodeId": "no-cap-d17-79",
            "texto": "O último lance mantém os xeques e a iniciativa; as Pretas abandonaram.",
            "pausa": "temporizada"
          },
          {
            "id": "narracao-no-cap-d17-79-2",
            "nodeId": "no-cap-d17-79",
            "texto": "O valor didático está em reconhecer nosso desenvolvimento, ativar as torres em colunas abertas e continuar jogando com iniciativa.",
            "pausa": "manual",
            "rotulo": "Resumo"
          }
        ]
      }
