    "introducoes": [
      {
        "id": "introducao-n0-ladder",
        "titulo": "Apresentação",
        "quadros": [
          {
            "id": "quadro-n0-ladder-introducao-1",
            "texto": "Duas torres e o rei contra um rei sozinho. Isto ganha sempre — e ganha rápido.",
            "posicao": {
              "tipo": "referencia",
              "origem": {
                "analiseId": "analise-n0-ladder-objetivo",
                "nodeId": "node-n0-ladder-objetivo-raiz"
              }
            },
            "desenhos": {
              "highlights": [
                "g1",
                "g2",
                "e3"
              ]
            }
          },
          {
            "id": "quadro-n0-ladder-introducao-2",
            "texto": "As torres não correm atrás dele. Cada uma fecha uma fileira, e ele desce uma de cada vez.",
            "posicao": {
              "tipo": "referencia",
              "origem": {
                "analiseId": "analise-n0-ladder-objetivo",
                "nodeId": "node-n0-ladder-objetivo-raiz"
              }
            },
            "desenhos": {
              "arrows": [
                [
                  "e3",
                  "e1"
                ]
              ]
            }
          },
          {
            "id": "quadro-n0-ladder-introducao-3",
            "texto": "Quando não sobrar nenhuma fileira para descer, é mate. É a fileira de baixo.",
            "posicao": {
              "tipo": "referencia",
              "origem": {
                "analiseId": "analise-n0-ladder-objetivo",
                "nodeId": "node-n0-ladder-objetivo-raiz"
              }
            },
            "desenhos": {
