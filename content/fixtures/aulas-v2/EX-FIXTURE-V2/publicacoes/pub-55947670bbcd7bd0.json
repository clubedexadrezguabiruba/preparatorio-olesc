                "a1",
                "b1",
                "c1",
                "d1",
                "e1",
                "f1",
                "g1",
                "h1"
              ]
            }
          }
        ]
      }
    ],
    "capitulos": [
      {
        "id": "capitulo-n0-ladder-objetivo",
        "titulo": "Uma fileira de cada vez",
        "resumo": "As torres não correm atrás do rei preto. Cada uma fecha uma fileira, e ele desce até não sobrar nenhuma.",
        "analiseId": "analise-n0-ladder-objetivo",
        "inicioNodeId": "node-n0-ladder-objetivo-raiz",
        "caminho": [
          "node-n0-ladder-objetivo-passo-3",
          "node-n0-ladder-objetivo-passo-4",
          "node-n0-ladder-objetivo-passo-5",
          "node-n0-ladder-objetivo-passo-6",
          "node-n0-ladder-objetivo-passo-7",
          "node-n0-ladder-objetivo-passo-8",
          "node-n0-ladder-objetivo-passo-9",
          "node-n0-ladder-objetivo-passo-10",
          "node-n0-ladder-objetivo-passo-11"
        ],
        "orientacao": "white",
        "narracoes": [
          {
            "id": "narracao-n0-ladder-1",
            "nodeId": "node-n0-ladder-objetivo-raiz",
            "texto": "Você joga de brancas: as suas torres estão em g1 e g2, e o rei preto está sozinho em e3.",
            "pausa": "temporizada"
          },
          {
            "id": "narracao-n0-ladder-2",
            "nodeId": "node-n0-ladder-objetivo-raiz",
            "texto": "O rei preto anda para onde quiser — por e4 ele sobe, e o tabuleiro inteiro é dele.",
            "pausa": "temporizada",
            "desenhos": {
              "highlights": [
                "e4"
              ]
            }
          },
          {
            "id": "narracao-n0-ladder-3",
            "nodeId": "node-n0-ladder-objetivo-passo-3",
            "texto": "A torre vai a g4. A quarta fileira inteira ficou tomada, e por e4 ele não passa mais.",
            "pausa": "temporizada",
            "esperaMs": 600
          },
          {
            "id": "narracao-n0-ladder-4",
            "nodeId": "node-n0-ladder-objetivo-passo-4",
            "texto": "Para cima não dá mais. O rei preto desce para d2.",
            "pausa": "temporizada"
          },
          {
            "id": "narracao-n0-ladder-5",
            "nodeId": "node-n0-ladder-objetivo-passo-5",
            "texto": "A outra torre vai a g3 e fecha a terceira fileira. O rei preto perdeu mais uma.",
            "pausa": "temporizada"
          },
          {
            "id": "narracao-n0-ladder-6",
            "nodeId": "node-n0-ladder-objetivo-passo-6",
            "texto": "Sobraram duas fileiras para ele andar. O rei preto desce para c1, na de baixo.",
            "pausa": "temporizada"
          },
          {
            "id": "narracao-n0-ladder-7",
            "nodeId": "node-n0-ladder-objetivo-passo-7",
            "texto": "A torre desce a g2 e fecha a segunda fileira. Agora ele está preso na fileira de baixo.",
            "pausa": "temporizada",
            "esperaMs": 600
          },
          {
            "id": "narracao-n0-ladder-8",
            "nodeId": "node-n0-ladder-objetivo-passo-8",
            "texto": "Não sobrou para onde ir, a não ser de lado. O rei preto anda para b1.",
            "pausa": "temporizada"
          },
          {
            "id": "narracao-n0-ladder-9",
            "nodeId": "node-n0-ladder-objetivo-passo-9",
            "texto": "As suas duas torres estão na mesma coluna, e uma tapa o caminho da outra. Esta vai a e2, sem largar a segunda fileira.",
            "pausa": "temporizada"
          },
          {
            "id": "narracao-n0-ladder-10",
            "nodeId": "node-n0-ladder-objetivo-passo-10",
            "texto": "O rei preto vai a a1, o canto. Ele não tem mais nenhuma fileira para descer.",
            "pausa": "temporizada"
          },
          {
            "id": "narracao-n0-ladder-11",
            "nodeId": "node-n0-ladder-objetivo-passo-11",
            "texto": "A torre de g4 desce a g1. Xeque-mate: o rei preto não tem nenhuma casa para onde ir.",
            "pausa": "temporizada",
            "esperaMs": 900
          },
          {
            "id": "narracao-n0-ladder-12",
            "nodeId": "node-n0-ladder-objetivo-passo-11",
            "texto": "Olhe o caminho que as torres fizeram: g4, g3, g2, g1. Isso tem nome — é o mate da escada.",
            "pausa": "temporizada",
            "desenhos": {
              "highlights": [
                "g4",
                "g3",
                "g2",
                "g1"
              ]
            },
            "esperaMs": 800
          },
          {
            "id": "narracao-n0-ladder-13",
            "nodeId": "node-n0-ladder-objetivo-passo-11",
            "texto": "Uma dama e uma torre fazem a mesma escada. Uma fecha a fileira, a outra fecha a de baixo.",
            "pausa": "temporizada",
            "esperaMs": 600
          }
        ]
      }
    ],
