# dependências
/node_modules
/.pnp
.pnp.*

# testes
/coverage

# next.js
/.next/
/out/
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
.pnpm-debug.log*

# variáveis de ambiente — as chaves do Supabase moram aqui e em nenhum
# lugar versionado. `.env.example` é a exceção: ele lista os nomes, nunca
# os valores.
.env*
!.env.example

# vercel
.vercel

# artefatos de inspeção do navegador (Playwright MCP)
/.playwright-mcp/

# typescript
*.tsbuildinfo
next-env.d.ts

# O CSV bruto do Lichess (~700 MB descompactado, ~5 milhões de linhas). O que
# o repositório versiona é o *recorte* em content/puzzles/, não a fonte.
/dados/

# Acrescentada pela CLI da Vercel no `vercel link`. O `.vercel` fica: é o par
# projeto/organização, e ele é local. O `.env*` que ela também escreveu saiu —
# ele já existe lá em cima, e escrito **depois** do `!.env.example` ele voltava
# a ignorar o arquivo que documenta os nomes das chaves. Uma linha silenciosa
# apagando a exceção da linha de cima.
.vercel

# O HTML intermediário do caderno e os recortes de conferência. O que fica
# versionado é o PDF em public/apostila/ — ele é o material entregue, e a
# Vercel não tem Chromium para regerá-lo na build.
/apostila/saida/
/.conferencia/

# Os rascunhos COM a prosa do Krikor e do Grigoryan. O gêmeo sem prosa, em
# content/repertorio/rascunhos/, é o versionado; este existe para quem escreve
# o comentário ter o argumento do autor na mão, e não pode entrar no Git —
# este repositório é público e a prosa é de curso pago. É derivado: volta
# inteiro com `npm run repertorio:importar`, como os originais que o
# REPERTORIO_FONTES aponta.
/content/repertorio/rascunhos-anotados/

# Rascunho de sessão: scripts de conferência, capturas de tela, geradores.
# Nada aqui é fonte de verdade — o que vale está em content/, lib/ e docs/.
.scratch/

# Cache do hook de design (plugin impeccable). Local, derivado, sem valor
# fora da sessão que o escreveu.
.impeccable/

# Os PGN dos estudos do Lichess que retranscrevem o Silman (`npm run
# finais:extrair`). Fora do Git pelo mesmo motivo de `rascunhos-anotados/`: eles
# carregam o prefácio e os comentários do autor transcritos por OCR — a
# expressão dele —, e este repositório é público. É derivado: volta inteiro da
# API pública do Lichess. O que fica versionado é content/finais/capitulos.json,
# com número, nome, FEN e lances — fato com proveniência.
/content/finais/estudos/

# Os dossiês da cauda (`npm run repertorio:cauda -- --dossies`): o que a fonte
# joga a partir de cada ponta, COM a prosa do autor, mais o que o explorer e o
# motor dizem. Fora do Git pelo mesmo motivo de `rascunhos-anotados/` — a prosa
# é de curso pago e este repositório é público. É derivado: volta inteiro do
# cache do explorer, que ESSE sim é versionado.
/content/repertorio/caudas/
