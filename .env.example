# As chaves do projeto Supabase. Copie este arquivo para `.env.local` e
# preencha — `.env.local` é `.gitignore`d e nunca sobe para o repositório.
#
# Onde achar cada uma, no painel do Supabase (supabase.com/dashboard):
#
#   Settings > API
#     Project URL         -> NEXT_PUBLIC_SUPABASE_URL
#     anon / public       -> NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY
#     service_role        -> SUPABASE_SERVICE_ROLE_KEY
#
#   Settings > Database > Connection string > URI
#     a do pooler (6543)  -> SUPABASE_DB_URL, com [YOUR-PASSWORD] trocado
#                            pela senha do banco

# Pública por desenho: vai no JavaScript entregue ao celular do aluno, e tudo
# que ela pode fazer é o que as políticas de RLS deixarem.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# **Passa por cima de toda a RLS.** Só o servidor a lê (`lib/supabase/admin.ts`
# é `server-only`, e a build falha se um componente de cliente a importar).
# Se ela vazar, qualquer pessoa lê e escreve o banco inteiro.
SUPABASE_SERVICE_ROLE_KEY=

# Só para `npm run db:migrar`. Não é lida pelo site.
SUPABASE_DB_URL=

# -- Repertorio de aberturas (F2) ------------------------------------------
#
# Token do explorer do Lichess, para `npm run repertorio:explorer` medir o que
# a faixa do clube joga de verdade (os recortes estao em lib/repertorio/
# explorer.ts; o numero e' da escala do Lichess, nao da do chess.com). Criar em lichess.org/account/oauth/token
# SEM marcar permissao nenhuma - ele so le banco publico. Sem ele a cobertura
# sai como "sem dados", e nada mais quebra: compilar e validar o repertorio
# nao dependem da rede.
LICHESS_TOKEN=

# As pastas com os PGN dos cursos, separadas por `;`. Ficam FORA do
# repositorio: e material de curso pago, e a prosa do autor nao entra no Git.
# O que entra e o rascunho sem prosa que `npm run repertorio:importar` escreve.
# Exemplo (Windows):
#   REPERTORIO_FONTES=C:\Users\voce\Downloads\repertorio-fontes;C:\Users\voce\Downloads\krikor
REPERTORIO_FONTES=

# -- Modo editor (aulas de finais) -----------------------------------------
#
# A chave que abre o editor na SUA maquina. Sem ela, `/editor` responde 404 --
# inclusive para o professor logado, inclusive em `npm run dev`. Sao tres
# condicoes, e esta e' a terceira: desenvolvimento, fora da Vercel, e isto.
#
# Por que e' preciso pedir: o editor escreve arquivos do repositorio. Um
# `next dev` aberto por um agente ou por um teste nao deve abrir essa porta sem
# que ninguem tenha pedido. O site publicado nao tem editor de jeito nenhum --
# o disco da Vercel e' somente leitura.
#
# A tranca de verdade continua sendo o login de professor; esta variavel so
# decide se a porta existe.
#
#   EDITOR_LOCAL=1
EDITOR_LOCAL=
