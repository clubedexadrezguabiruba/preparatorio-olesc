# As chaves do projeto Supabase. Copie este arquivo para `.env.local` e
# preencha — `.env.local` é `.gitignore`d e nunca sobe para o repositório.
#
# Onde achar cada uma, no painel do Supabase (supabase.com/dashboard):
#
#   Settings > API
#     Project URL         -> NEXT_PUBLIC_SUPABASE_URL
#     anon / public       -> NEXT_PUBLIC_SUPABASE_ANON_KEY
#     service_role        -> SUPABASE_SERVICE_ROLE_KEY
#
#   Settings > Database > Connection string > URI
#     a do pooler (6543)  -> SUPABASE_DB_URL, com [YOUR-PASSWORD] trocado
#                            pela senha do banco

# Pública por desenho: vai no JavaScript entregue ao celular do aluno, e tudo
# que ela pode fazer é o que as políticas de RLS deixarem.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# **Passa por cima de toda a RLS.** Só o servidor a lê (`lib/supabase/admin.ts`
# é `server-only`, e a build falha se um componente de cliente a importar).
# Se ela vazar, qualquer pessoa lê e escreve o banco inteiro.
SUPABASE_SERVICE_ROLE_KEY=

# Só para `npm run db:migrar`. Não é lida pelo site.
SUPABASE_DB_URL=
