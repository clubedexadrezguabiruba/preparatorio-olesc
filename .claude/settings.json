{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$(git rev-parse --show-toplevel 2>/dev/null)/.claude/exame-de-sangue.sh\" 2>/dev/null || true",
            "timeout": 25,
            "statusMessage": "Conferindo o git com o servidor..."
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$(git rev-parse --show-toplevel 2>/dev/null)/.claude/hooks/maquinas-do-pgn.sh\" 2>/dev/null || true",
            "timeout": 120,
            "statusMessage": "Rodando as máquinas sobre o PGN da aula..."
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$(git rev-parse --show-toplevel 2>/dev/null)/.claude/hooks/portao-de-publicacao.sh\" 2>/dev/null || true",
            "timeout": 30,
            "statusMessage": "Conferindo se a aula passou pelos cinco revisores..."
          }
        ]
      }
    ]
  }
}
